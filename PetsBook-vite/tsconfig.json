    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": [ "DOM", "DOM.Iterable", "ESNext" ],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist",
    },
    "include": [ "src" ]
}

